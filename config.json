{
  "process_all": false,

  "single_run": {
    "station": "ELBA",
    "earthquake_name": "20250423_M6.3_Silivri"
  },

  "paths": {
    "raw_dir": "raw",
    "results_dir": "results",
    "results_subdir": "ENZ",
    "cache_dir": "cache",
    "data_dir": "data",
    "data_pattern": "*_{station}_*.mseed",
    "catalog": "catalog_current.csv",
    "station_coords": "station_coords.csv"
  },

  "target": {
    "start_date": null,
    "duration_days": 7,
    "quiet_window": false
  },

  "quiet_window": {
    "samples": 15,
    "min_mag": 3.0,
    "max_dist_km": 300,
    "seed": 0
  },

  "cache": {
    "enabled": false
  },

  "mean_period_estimation": {
    "options": {
      "max_dist_km": 300,
      "dayfirst": true,
      "catalog_utc_offset": 0,
      "chunks": 20,
      "jobs": 4
    }
  },

  "preprocessing": {
    "freq_min": 0.1,
    "freq_max": 2.0,
    "gap_threshold_sec": 2.0,
    "filter_pad_sec": null,
    "channels": ["E", "N", "Z"]
  },

  "feature_extraction": {
    "fs": 5.0,
    "win_sec": 200,
    "step_sec": 50,
    "max_gap_sec": null,
    "channels": ["N"],
    "n_jobs": -1,
    "warmup_count": 3,

    "features": {
      "wolf": {
        "tau": 5,
        "m": 5,
        "evolve": 5,
        "min_samples": 500
      },
      "rosenstein": {
        "tau": 5,
        "m": 5,
        "slope": [0, 1, 4, 10],
        "mean_period": null
      },
      "sample_entropy": {
        "m": 2,
        "r": 0.2
      },
      "corr_dim": {
        "tau": 5,
        "m": 5
      }
    }
  }
}
